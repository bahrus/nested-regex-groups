{
  "name": "nested-regex-groups",
  "version": "0.0.3",
  "description": "Support nested regexp parsing with dot notation in capture group names",
  "homepage": "https://github.com/bahrus/nested-regex-groups#readme",
  "bugs": {
    "url": "https://github.com/bahrus/nested-regex-groups/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/nested-regex-groups.git"
  },
  "license": "MIT",
  "author": "Bruce B. Anderson <anderson.bruce.b@gmail.com>",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./template": {
      "types": "./template.d.ts",
      "import": "./template.js"
    },
    "./index.js": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./template.js": {
      "types": "./template.d.ts",
      "import": "./template.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "index.d.ts.map",
    "template.js",
    "template.d.ts",
    "template.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "example": "npm run build && node examples/basic-usage.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "regex",
    "regexp",
    "nested",
    "groups",
    "capture",
    "parser",
    "dot-notation",
    "hierarchical"
  ]
}
